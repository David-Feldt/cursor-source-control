{
  "name": "cursor-source-control",
  "displayName": "Source Control Panel",
  "description": "Enhanced source control panel showing +/- line stats, parent folder grouping, Material icons, and AI-powered change summaries",
  "version": "0.1.0",
  "publisher": "david",
  "repository": {
    "type": "git",
    "url": "https://github.com/YOUR_USERNAME/cursor-source-control.git"
  },
  "bugs": {
    "url": "https://github.com/YOUR_USERNAME/cursor-source-control/issues"
  },
  "homepage": "https://github.com/YOUR_USERNAME/cursor-source-control#readme",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sourceControlPanelContainer",
          "title": "Source Control Panel",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "sourceControlPanelContainer": [
        {
          "id": "sourceControlPanel",
          "name": "Changes",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "sourceControlPanel.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      }
    ],
    "configuration": {
      "title": "Source Control Panel",
      "properties": {
        "sourceControlPanel.geminiApiKey": {
          "type": "string",
          "default": "",
          "description": "Google Gemini API key for AI-powered change summaries. Get one at https://aistudio.google.com/app/apikey",
          "order": 1
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "sourceControlPanel.refresh",
          "when": "view == sourceControlPanel",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "material-icon-theme": "^5.32.0"
  }
}
